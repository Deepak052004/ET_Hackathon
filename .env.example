# SafetyNexus AI — Environment Variables
# Copy this to .env and fill in your values

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# These are auto-configured by docker-compose — only change if running locally without Docker
DATABASE_URL=postgresql://safetynexus:safetynexus123@localhost:5432/safetynexus_db
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=safetynexus123
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

ENVIRONMENT=development
